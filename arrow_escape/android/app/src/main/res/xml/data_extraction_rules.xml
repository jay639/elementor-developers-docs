<?xml version="1.0" encoding="utf-8"?>
<!-- The save is encrypted with a key held in the Android Keystore, which is
     not backed up, so restoring the file elsewhere would be useless; the
     cloud save (Firestore) is the backup instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>

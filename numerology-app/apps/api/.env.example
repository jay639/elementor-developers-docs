# ---------------------------------------------------------------------------
# Ank Jyoti API - example environment file.
# Copy to .env for local development. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# development | staging | production
APP_ENV=development

# PostgreSQL connection string.
DATABASE_URL=postgresql://numerology:numerology@localhost:5432/numerology_dev?schema=public

# --- Authentication -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ADMIN_JWT_ACCESS_SECRET=replace-me-with-a-third-long-random-string
ADMIN_JWT_REFRESH_SECRET=replace-me-with-a-fourth-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_ACCESS_TOKEN_TTL=30m
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- CORS -----------------------------------------------------------------
# Comma separated list of origins allowed to call the API (the admin panel).
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Seeding --------------------------------------------------------------
# Used only by `npm run db:seed` to create the first super administrator.
SEED_ADMIN_EMAIL=admin@ankjyoti.app
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Super Admin

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info

# --- Push notifications (optional, feature is off until configured) --------
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

// Ank Jyoti - database schema.
//
// Conventions used throughout:
//   * UUID primary keys, so ids can be generated client side and are not guessable.
//   * created_at / updated_at on every table.
//   * deleted_at (soft delete) on anything a user or an administrator can remove.
//   * All user facing copy is localised: content tables carry a `locale` column
//     and are unique on (business key, locale) for en / hi / mr.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  hi
  mr
}

enum AuthProvider {
  GUEST
  EMAIL
  GOOGLE
  APPLE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum CalculationType {
  CORE_NUMBERS
  LUCKY_NUMBER
  NAME_NUMEROLOGY
  MARRIAGE_COMPATIBILITY
  DAILY_NUMBER
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  DISCLAIMER
  ABOUT
}

enum Platform {
  ANDROID
  IOS
  WEB
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String?      @unique
  passwordHash    String?      @map("password_hash")
  provider        AuthProvider @default(GUEST)
  providerUserId  String?      @map("provider_user_id")
  isGuest         Boolean      @default(true) @map("is_guest")
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?    @map("email_verified_at")
  lastLoginAt     DateTime?    @map("last_login_at")
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  profile       UserProfile?
  preferences   UserPreference?
  refreshTokens RefreshToken[]
  history       CalculationHistory[]
  favourites    Favourite[]
  devices       DeviceToken[]
  events        AnalyticsEvent[]

  @@index([provider, providerUserId])
  @@index([createdAt])
  @@index([status, deletedAt])
  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  displayName String?   @map("display_name")
  /// Stored as a plain calendar date - never a timestamp, so a birthday can
  /// never shift across a timezone boundary.
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      Gender    @default(UNSPECIFIED)
  phone       String?
  photoUrl    String?   @map("photo_url")
  /// Denormalised from date_of_birth by the calculation service so lists and
  /// analytics do not have to recompute them.
  mulank      Int?
  bhagyank    Int?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  locale               Locale    @default(en)
  theme                ThemeMode @default(SYSTEM)
  notificationsEnabled Boolean   @default(false) @map("notifications_enabled")
  dailyNumberOptIn     Boolean   @default(false) @map("daily_number_opt_in")
  analyticsConsent     Boolean   @default(false) @map("analytics_consent")
  marketingConsent     Boolean   @default(false) @map("marketing_consent")
  /// When false, shared result cards hide the date of birth.
  shareDobOnCards      Boolean   @default(false) @map("share_dob_on_cards")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Only a SHA-256 hash of the token is stored, never the token itself.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  Platform
  locale    Locale   @default(en)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ---------------------------------------------------------------------------
// Numerology content (fully administrator editable, per locale)
// ---------------------------------------------------------------------------

model NumerologyNumber {
  id                  String   @id @default(uuid()) @db.Uuid
  number              Int
  locale              Locale
  name                String
  title               String
  summary             String
  personality         String
  behaviour           String
  strengths           String[]
  weaknesses          String[]
  career              String
  relationships       String
  general             String
  luckyNumbers        Int[]    @map("lucky_numbers")
  unfavourableNumbers Int[]    @map("unfavourable_numbers")
  colors              String[]
  notes               String?
  isPublished         Boolean  @default(true) @map("is_published")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([number, locale])
  @@index([locale, isPublished])
  @@map("numerology_numbers")
}

/// One row per (mulank, bhagyank, locale): 81 combinations per language.
/// When a row is missing or unpublished the API falls back to the individual
/// Mulank and Bhagyank interpretations.
model MulankBhagyankCombination {
  id              String   @id @default(uuid()) @db.Uuid
  mulank          Int
  bhagyank        Int
  locale          Locale
  title           String
  description     String
  personality     String
  strengths       String[]
  challenges      String[]
  career          String
  relationships   String
  recommendations String
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([mulank, bhagyank, locale])
  @@index([locale, isPublished])
  @@map("mulank_bhagyank_combinations")
}

/// Directional marriage compatibility rule. The engine evaluates the table
/// twice - male -> female and female -> male - so this is not a "male only" row.
model MarriageCompatibilityRule {
  id                 String   @id @default(uuid()) @db.Uuid
  driverNumber       Int      @unique @map("driver_number")
  compatibleMulank   Int[]    @map("compatible_mulank")
  compatibleBhagyank Int[]    @map("compatible_bhagyank")
  enabled            Boolean  @default(true)
  /// Localised administrator note, e.g. { "en": "...", "hi": "...", "mr": "..." }.
  notes              Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("marriage_compatibility_rules")
}

/// Friendly / neutral / unfriendly relationships used by the Lucky Number Finder.
model NumberCompatibilityRule {
  id         String   @id @default(uuid()) @db.Uuid
  baseNumber Int      @unique @map("base_number")
  friendly   Int[]
  neutral    Int[]
  unfriendly Int[]
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("number_compatibility_rules")
}

model ChaldeanMapping {
  id        String   @id @default(uuid()) @db.Uuid
  letter    String   @unique @db.VarChar(1)
  value     Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chaldean_mappings")
}

/// Short interpretation shown under Today's Lucky Number on the home screen.
model DailyNumberInsight {
  id        String   @id @default(uuid()) @db.Uuid
  number    Int
  locale    Locale
  title     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([number, locale])
  @@map("daily_number_insights")
}

model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  locale      Locale
  title       String
  body        String
  version     String            @default("1.0")
  publishedAt DateTime?         @map("published_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([type, locale])
  @@map("legal_documents")
}

// ---------------------------------------------------------------------------
// User activity
// ---------------------------------------------------------------------------

model CalculationHistory {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  type            CalculationType
  /// Short human readable label, e.g. "MH 31 AB 1234" or "Rahul".
  label           String
  /// Exactly what the user submitted, minus anything not needed to reproduce it.
  input           Json
  /// The full calculated result, so history renders without recalculating.
  result          Json
  primaryNumber   Int?            @map("primary_number")
  secondaryNumber Int?            @map("secondary_number")
  locale          Locale          @default(en)
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  favourites Favourite[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, deletedAt])
  @@map("calculation_history")
}

model Favourite {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  historyId String?         @map("history_id") @db.Uuid
  type      CalculationType
  label     String
  input     Json
  result    Json
  deletedAt DateTime?       @map("deleted_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  history CalculationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("favourites")
}

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// Anonymous client session id, so guest activity can be counted without
  /// attaching it to an identity.
  sessionId  String?  @map("session_id")
  name       String
  properties Json     @default("{}")
  locale     Locale   @default(en)
  platform   Platform @default(ANDROID)
  appVersion String?  @map("app_version")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

model AppSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  group       String   @default("general")
  description String?
  /// Public settings are served to the mobile app without authentication.
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

model AdminRole {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  /// Permission strings such as "content:write" or "users:delete".
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  admins AdminUser[]

  @@map("admin_roles")
}

model AdminUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  roleId       String      @map("role_id") @db.Uuid
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?   @map("last_login_at")
  /// Set when a seeded administrator must change the initial password.
  mustChangePassword Boolean @default(false) @map("must_change_password")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  role          AdminRole           @relation(fields: [roleId], references: [id])
  refreshTokens AdminRefreshToken[]
  auditLogs     AuditLog[]

  @@index([status, deletedAt])
  @@map("admin_users")
}

model AdminRefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  userAgent   String?   @map("user_agent")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, revokedAt])
  @@map("admin_refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String?  @map("admin_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
